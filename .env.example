# Copy to .env and fill in. NEVER share your .env (it contains the bot token)!
DISCORD_TOKEN=
GUILD_ID=

# Channel nobody is supposed to post in
HONEYPOT_CHANNEL_ID=
# Channel where the bot reports what it did (visible to mods only)
LOG_CHANNEL_ID=
# Optional: role given to quarantined users (e.g. for a #quarantine channel)
QUARANTINE_ROLE_ID=

# Role users get by clicking the "accept rules" button (/rules-button)
MEMBER_ROLE_ID=

# What happens when someone posts in the honeypot:
#   quarantine = strip all roles (mods review afterwards and release or ban)
#   softban    = kick + delete messages (user can rejoin)
#   ban        = ban + delete messages
HONEYPOT_ACTION=quarantine
# Delete the user's messages from the last X minutes
CLEANUP_MINUTES=10
